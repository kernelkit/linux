		"",               "",               "",               "",               /* 12..15 */
		"",               "",               "",               "NC",             /* 16..19 */
		"NC",             "",               "",               "",               /* 20..23 */
		"",               "",               "",               "",               /* 24..27 */
		"",               "",               "",               "";               /* 28..31 */
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart_cp3_pins_default>;
	status = "okay";
	rts-gpios = <&gpio3 19 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart_cp1_pins_default>;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart_cp2_pins_default>;
	status = "okay";
	rts-gpios = <&gpio3 18 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
};

&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart_debug_console_pins_default>;
};

&uart4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart_iobus_pins_default>;
	rts-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
	rx-disable-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
	dmas = <&edma_xbar 14 2 9>, <&edma_xbar 15 2 10>;
	dma-names = "tx", "rx";
};

&mmc1 {
	status = "okay";
	vmmc-supply = <&dcdc4>;
	bus-width = <4>;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_pins_default>;
};

&mac {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&eth_cpsw_pins_default>;
	slaves = <1>;
};

&davinci_mdio {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins_default>;

	ethphy0: ethernet-phy@0 {
		reg = <1>;
		ti,strap-duplex-mode = <1>;
		ti,strap-auto-neg-enable = <1>;
		ti,strap-speed-select = <1>;
		ti,strap-advertise-10te-half = <1>;
		ti,strap-advertise-10te-full = <1>;
		ti,strap-advertise-100tx-half = <1>;
		ti,strap-advertise-100tx-full = <1>;
		ti,strap-100base-fx-enable = <0>;
		ti,strap-rmii-clock-select = <0>;
		ti,strap-rgmii-mode-enable = <0>;
		ti,strap-led0-polarity = <0>;
		ti,strap-auto-mdix-enable = <0>;
		ti,strap-led-configuration = <0>;
		ti,strap-mled-polarity-swap = <0>;
		ti,strap-eee-capa-enable = <0>;
	};
};

&cpsw_emac0 {
	phy-handle = <&ethphy0>;
	phy-mode = "mii";
};

&gpmc {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sram_128x16_pins_default>;
	ranges = <0x0 0x0 0x1000000 0x40000>;

	#address-cells = <2>;
	#size-cells = <1>;

	sram@0,0 {
		reg = <0x0 0x0 0x40000>; /* 256kB */
		bank-width = <0x2>;
		gpmc,cs-on-ns = <0x0>;
		gpmc,cs-rd-off-ns = <0x2e>;
		gpmc,cs-wr-off-ns = <0x2d>;
		gpmc,adv-on-ns = <0x0>;
		gpmc,adv-rd-off-ns = <0x2e>;
		gpmc,adv-wr-off-ns = <0x2d>;
		gpmc,we-on-ns = <0x0>;
		gpmc,we-off-ns = <0x2d>;
		gpmc,oe-on-ns = <0x0>;
		gpmc,oe-off-ns = <0x2d>;
		gpmc,access-ns = <0x2e>;
		gpmc,rd-cycle-ns = <0x3f>;
		gpmc,wr-cycle-ns = <0x2d>;
	};
};
