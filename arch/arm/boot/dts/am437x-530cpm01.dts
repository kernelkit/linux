		"",                   "",                        "",                     "",                     /* 0..3 */
		"",                   "",                        "",                     "",                     /* 4..7 */
		"",                   "",                        "",                     "",                     /* 8..11 */
		"",                   "",                        "NC",                   "NC",                   /* 12..15 */
		"NC",                 "GPIO_DE_IN_OUT_CPM01_03", "GPIO_EN_RS485_TX_CP2", "GPIO_EN_RS485_TX_CP3", /* 16..19 */
		"GPIO_UC_ACT_LED",    "GPIO_UC_SPEED_LED",       "GPIO_5V_IO_ENN",       "GPIO_5V_IO_FAULTN",    /* 20..23 */
		"GPIO_EN_DE_IO_LEFT", "GPIO_ETH_RESETN",         "",                     "",                     /* 24..27 */
		"",                   "",                        "",                     "";                     /* 28..31 */
