	status = "okay";
	gpio-line-names =
		"NC",                   "NC",                   "NC",                   "NC",             /* 0..3 */
		"NC",                   "SYSBOOT_18",           "SYSBOOT_17",           "GPIO_RUN_LED",   /* 4..7 */
		"GPIO_ERROR_LED",       "GPIO_DEFAULT_STATEN",  "GPIO_TIME_SYNC_OUT0N", "NC",             /* 8..11 */
		"GPIO_TIME_SYNC_OUT1N", "GPIO_TIME_SYNC_OUT2N", "",                     "",               /* 12..15 */
		"",                     "",                     "NC",                   "",               /* 16..19 */
