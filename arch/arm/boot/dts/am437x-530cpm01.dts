	gpio-line-names =
		"",                 "",                 "",                 "",                  /* 0..3 */
		"NC",               "NC",               "GPIO_BIT_PROT_IN", "GPIO_BIT_PROT_OUT", /* 4..7 */
		"",                 "",                 "SYSBOOT_14",       "SYSBOOT_15",        /* 8..11 */
		"NC",               "GPIO_UART4_TX_EN", "",                 "",                  /* 12..15 */
		"",                 "",                 "",                 "NC",                /* 16..19 */
		"GPIO_PHY_CLK",     "",                 "",                 "",                  /* 20..23 */
		"GPIO_EMMC_RESETN", "GPIO_USB0_FAULTN", "",                 "",                  /* 24..27 */
		"",                 "GPIO_UART4_RX_EN", "",                 "";                  /* 28..31 */
};

