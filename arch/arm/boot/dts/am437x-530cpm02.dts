	pinctrl-names = "default";
	pinctrl-0 = <&gpio3_pins_default>;
	status = "okay";
	gpio-line-names =
		"",                   "",                   "",                       "",                         /* 0..3 */
		"",                   "",                   "",                       "",                         /* 4..7 */
		"",                   "",                   "",                       "",                         /* 8..11 */
		"",                   "",                   "",                       "GPIO_SPI0_IRQ0N",          /* 12..15 */
		"GPIO_SPI0_IRQ0N",    "GPIO_TIME_SYNC_IN0", "GPIO_UC_ACT_LED2_CPM02", "GPIO_UC_SPEED_LED2_CPM02", /* 16..19 */
		"GPIO_UC_ACT_LED",    "GPIO_UC_SPEED_LED",  "NC",                     "NC",                       /* 20..23 */
		"GPIO_EN_DE_IO_LEFT", "GPIO_ETH_RESETN",    "",                       "",                         /* 24..27 */
