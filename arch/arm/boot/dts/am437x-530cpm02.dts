		"",                     "",                 "NC",               "NC",         /* 4..7 */
		"",                     "",                 "SYSBOOT_14",       "SYSBOOT_15", /* 8..11 */
		"GPIO_EN_IO_BUS_LEFT",  "GPIO_UART4_TX_EN", "",                 "",           /* 12..15 */
		"",                     "",                 "",                 "NC",         /* 16..19 */
		"GPIO_DE_IN_OUT_CPM02", "",                 "",                 "",           /* 20..23 */
		"GPIO_EMMC_RESETN",     "GPIO_USB0_FAULTN", "",                 "",           /* 24..27 */
		"",                     "GPIO_UART4_RX_EN", "",                 "";           /* 28..31 */
