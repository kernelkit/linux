&gpio5 {
	pinctrl-names = "default";
	pinctrl-0 = <&gpio5_pins_default>;
	status = "okay";
	gpio-line-names =
		"GPIO_CAN_RESET",      "GPIO_CAN_INTN",  "",               "",                    /* 0..3 */
		"GPIO_HW_IDENT0",      "GPIO_HW_IDENT1", "GPIO_HW_IDENT2", "GPIO_HW_IDENT3",      /* 4..7 */
		"",                    "",               "",               "",                    /* 8..11 */
		"",                    "",               "",               "",                    /* 12..15 */
		"",                    "",               "",               "GPIO_SPI0_FEEDBACKN", /* 16..19 */
		"GPIO_RESET_SERIAL1N", "",               "",               "",                    /* 20..23 */
		"",                    "",               "",               "",                    /* 24..27 */
		"",                    "",               "",               "";                    /* 28..31 */
};

&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart_debug_console_pins_default>;
	u-boot,dm-spl;
};

&uart4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart_iobus_pins_default>;
	rts-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
	rx-disable-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
	dmas = <&edma_xbar 14 2 9>, <&edma_xbar 15 2 10>;
	dma-names = "tx", "rx";
};

&mmc1 {
	status = "okay";
	vmmc-supply = <&dcdc4>;
	bus-width = <4>;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_pins_default>;
};

&mac {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&eth_cpsw_pins_default>;
	dual_emac;
};

&davinci_mdio {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins_default>;
	compatable = "ti, cpsw-mdio","ti,davinci_mdio";

	ethphy0: ethernet-phy@0{
		reg = <0>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_1_75_NS>;
		ti,tx-internal-delay = <DP83867_RGMIIDCTL_1_75_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,min-output-impedence;
		ti,dp83867-rxctrl-strap-quirk;
	};
	ethphy1: ethernet-phy@1{
		reg = <1>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_1_75_NS>;
		ti,tx-internal-delay = <DP83867_RGMIIDCTL_1_75_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,min-output-impedence;
		ti,dp83867-rxctrl-strap-quirk;
	};
};

&cpsw_emac0 {
	phy_id = <&ethphy0>;
	phy-mode = "rgmii-txid";
	dual_emac_res_vlan = <1>;
};

&cpsw_emac1 {
	phy_id = <&ethphy1>;
	phy-mode = "rgmii-txid";
	dual_emac_res_vlan = <2>;
};

&gpmc {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sram_128x16_pins_default>;
	ranges = <0x0 0x0 0x1000000 0x40000>;

	#address-cells = <2>;
	#size-cells = <1>;

	sram@0,0 {
		reg = <0x0 0x0 0x40000>; /* 256kB */
		bank-width = <0x2>;
		gpmc,cs-on-ns = <0x0>;
		gpmc,cs-rd-off-ns = <0x2e>;
		gpmc,cs-wr-off-ns = <0x2d>;
		gpmc,adv-on-ns = <0x0>;
		gpmc,adv-rd-off-ns = <0x2e>;
		gpmc,adv-wr-off-ns = <0x2d>;
		gpmc,we-on-ns = <0x0>;
		gpmc,we-off-ns = <0x2d>;
		gpmc,oe-on-ns = <0x0>;
		gpmc,oe-off-ns = <0x2d>;
		gpmc,access-ns = <0x2e>;
		gpmc,rd-cycle-ns = <0x3f>;
		gpmc,wr-cycle-ns = <0x2d>;
	};
};

&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_atsam_pins_default>;
	dmas = <&edma 16 0
		&edma 17 0
		&edma 18 0
		&edma 19 0
		&edma 20 0
		&edma 21 0
		&edma_xbar 53 0 26
		&edma_xbar 54 0 27>;
	dma-names = "tx0", "rx0", "tx1", "rx1", "tx2", "rx2", "tx3", "rx3";
};

&spi3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi3_can_fd_pins_default>;
	dmas = <&edma_xbar 42 0 53
		&edma_xbar 43 0 54>;
	dma-names = "tx0", "rx0";

	tcan4x5x: tcan4x5x@0 {
		compatible = "ti,tcan4x5x";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <12000000>;
		bosch,mram-cfg = <0x0 0 0 32 0 0 1 1>;
		interrupt-parent = <&gpio4>;
		interrupts = <19 IRQ_TYPE_LEVEL_LOW>;
	};
};

