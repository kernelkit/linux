&gpio4 {
	pinctrl-names = "default";
	pinctrl-0 = <&gpio4_pins_default>;
	status = "okay";
	gpio-line-names =
		"GPIO_5V_SENSE",        "NC",                   "NC",                   "NC",                      /* 0..3 */
		"NC",                   "SYSBOOT_18",           "SYSBOOT_17",           "GPIO_RUN_LED",            /* 4..7 */
		"GPIO_ERROR_LED",       "GPIO_DEFAULT_STATEN",  "GPIO_TIME_SYNC_OUT0N", "GPIO_DISABLE_CAN_RIGHTN", /* 8..11 */
		"GPIO_TIME_SYNC_OUT1N", "GPIO_TIME_SYNC_OUT2N", "",                     "",                        /* 12..15 */
		"",                     "",                     "GPIO_CAN_GPIO2N",      "GPIO_CAN_GPIO1N",         /* 16..19 */
		"GPIO_EN_IO_BUS_RIGHT", "GPIO_EN_DE_IO_RIGHT",  "",                     "",                        /* 20..23 */
		"GPIO_ETH_INTN",        "GPIO_ETH2_INTN",       "GPIO_MMC0_DAT4",       "GPIO_MMC0_DAT5",          /* 24..27 */
		"GPIO_MMC0_DAT6",       "GPIO_MMC0_DAT7",       "",                     "";                        /* 28..31 */
